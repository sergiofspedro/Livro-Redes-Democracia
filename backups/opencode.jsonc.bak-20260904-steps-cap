    // on Aug 6 -- never once connected, while still costing 32,512 tokens because the
    // tool schemas stay resident even with the server down. Cause: OpenCode's MCP
    // `timeout` defaults to 5000ms and measures spawn -> tools/list. Measured here,
    // idle machine: via npx 3.91s, and ~10 MCP servers race each other at launch, which
    // pushes it past 5s every time. Two changes: call the globally installed binary so
    // npx doesn't re-resolve the package on every spawn (2.39s, ~40% faster), and set an
    // explicit timeout with real headroom for the native Rust engines and tray icon.
    // Installed with: npm i -g @harusame64/desktop-touch-mcp@1.14.3
    "desktop-touch": {
      "type": "local",
      "command": [
        "C:\\Users\\Administrator\\AppData\\Roaming\\npm\\desktop-touch-mcp.cmd"
      ],
      "enabled": true,
      "timeout": 30000
    },
