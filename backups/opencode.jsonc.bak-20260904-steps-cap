      "enabled": true,
      "environment": {
        "WORKSPACE_ROOTS": "C:\\Users\\Administrator\\workspaces",
        "TOKEN_SAVIOR_CLIENT": "opencode",
        "TOKEN_SAVIOR_PROFILE": "compact-only"
      }
    },
    "serena": {
      "type": "local",
      "command": [
        "C:\\Users\\Administrator\\.local\\bin\\serena.exe",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project",
        "C:\\Users\\Administrator\\Documents\\Opencode",
        "--enable-web-dashboard",
        "False",
        "--open-web-dashboard",
        "False"
