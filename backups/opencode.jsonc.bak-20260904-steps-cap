{
  "$schema": "https://opencode.ai/config.json",
  // 2026-08-29: default_agent voltou a "orchestrator" (a pedido do utilizador).
  // Backup: opencode.jsonc.bak-20260829-default-orchestrator. Aplica-se no próximo
  // restart do OpenChamber.
  "default_agent": "orchestrator",
  // small_model (2026-08-31): sem esta chave o opencode usa o modelo do agente PRIMARIO
  // para todas as chamadas small=true (titulos, resumos). O primario e o `orchestrator`,
  // cuja cadeia comeca no OpenRouter -- que devolve HTTP 402 e so depois cai para o
  // minimax. Resultado medido: ~17s so para gerar o titulo de cada sessao nova, que
  // depois ficava presa no step=0 sem nunca produzir uma linha `process`. Espelha o VPS.
  "small_model": "smart-router/smart-free",
  "lsp": true,
  "plugin": [
    "./plugins/subagent-loop-guard.ts",
    // chunkTimeoutMs raised from its 45s default 2026-08-15. This is the actual cause of
    // the "vps-mcp_list_servers loop": a ~130k-token prompt on the free/slow tier takes
    // longer than 45s to produce its first chunk, so auto-resume declared the turn stalled
    // and re-issued the SAME request. Each retry re-ran the same tool calls, which is what
    // looked like the model looping. Proof: input tokens were byte-identical across the
    // repeated turns (163,683 then 130,933 -- a continuing conversation would grow), and
    // magic-context logged only 2 transform decisions with dropped_tokens=0 for 35+ calls.
    // It also explains why sessions "escaped" around turn 8: once the prompt cache warmed,
    // responses returned under 45s and the retries stopped.
    [
      "opencode-auto-resume",
      {
        "chunkTimeoutMs": 300000,
        "subagentWaitMs": 60000
      }
    ],
    "cc-safety-net",
    // "@cortexkit/opencode-magic-context@0.40.1",  // DISABLED 2026-08-28: replaced by open-mem trial. Backup: opencode.jsonc.bak-20260828-openmem
    "@franlol/opencode-md-table-formatter@0.0.6",
    // "opencode-snip@latest" -- disabled 2026-08-19. Its tool.execute.before hook
    // prefix-prefixes every bash command with `snip`, and the snip CLI (v0.20.0,
    // "CLI Token Killer") CORRUPTS compound PowerShell commands: it eats $vars,
    // strips `=`, breaks regex like \d+, and breaks pipes -- forcing silent
    // failures, retries and "walking in circles" (confirmed in 3 sessions
    // analyzed 2026-08-19, including an 11.9M-token session). The binary stays in
    // ~/.local/bin/snip.exe for manual use (`snip run -- <cmd>`). Re-enable only
    // if upstream fixes command fidelity; see opencode-snip/src/index.ts.
    // openslimedit added 2026-08-20 (token-saving analysis, proposal 1): compresses tool
    // descriptions + compact read output + line-range edit support. 11-45% input token
    // savings (benchmarks on GPT/Claude; our CC1/CC2 deepseek/mimo not covered -- tested
    // 1 session before relying on it). Hooks-only, no custom tools, no system prompt
    // injection, compatible with deny lists. Backup .bak-20260820-tokensaving.
    "openslimedit@latest",
    "opencode-log-sanitizer",
    "@ramtinj95/opencode-tokenscope@latest",
    "./plugins/open-controller-patched/dist/index.js", // 2026-09-01 shim: open-controller@2.0.2 ships v2-Effect default export {id, server} but opencode 1.18.25 expects v1 (plain fn). Patch on dist/index.js line 185: export default PcControllerPlugin. Re-apply if .bak-20260901-pc-exec-export file is restored or shim is regenerated.
    "opencode-planner@latest",
    [
      "@plannotator/opencode@0.23.1",
      {
        "workflow": "plan-agent",
        "planningAgents": [
          "plan"
        ]
      }
    ], // pinned 2026-08-09: current npm @latest (0.26.4) fails to load - "Could not find bundled HTML asset: review-editor.html". 0.23.1 is the version already cached here and known working.
    "opencode-github-release",
    "opencode-update-notifier@0.3.3",
    "opencode-pty",
    "@thecto/opencode-debug-plugin@latest",
    "@rolled-potatoes/opencode-mermaid",
    [
      "opencode-translate",
      {
        "model": "smart-router/smart-flash",
        "lang": "Portuguese"
      }
    ],
    "opencode-timer-plugin",
    "opencode-devjournal",
    // Triage plugins added 2026-09-04: opencode-mcp-triage routes MCP work to scoped subagents (~80% token savings), opencode-triage routes skills via keyword matching (~90% token savings). Both add `triage()` tool, register /mcp-triage and /triage commands.
