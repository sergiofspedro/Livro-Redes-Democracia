  "provider": {
    // "opencode" provider block removed 2026-08-15: it existed only to hand-declare
    // deepseek-v4-flash-free as {context:128000, input:150000, output:8000}. The real
    // registry says {context:200000, output:128000} -- the override both understated
    // the model and, worse, invented an `input` cap. magic-context prefers limit.input
    // over limit.context (models-dev-cache.ts), so that 150000 became the context limit
    // it enforced: 163,186 tokens / 150,000 = 109%, which put every session into
    // permanent compaction from turn 1. Let the registry value stand.
    "smart-router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8765/v1"
      },
      "models": {
        "smart-pro": {
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "smart-flash": {
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        // smart-orchestrator (2026-08-29, antes "smart-route" 2026-08-27): cadeia so para o
        // ORQUESTRADOR. Cabeca z-ai/glm-5.3-flash via OpenRouter; fallbacks minimax free ->
        // mimo-v2.5-free -> deepseek-v4-flash. Renomeado para o nome refletir o papel.
        "smart-orchestrator": {
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "smart-vision": {
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "smart-free": {
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "smart-dream": {
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "smart-history": {
          "limit": {
            "context": 200000,
            "output": 128000
          }
        }
      }
    }
