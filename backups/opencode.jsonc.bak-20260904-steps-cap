      "type": "local",
      "command": [
        "C:\\Users\\Administrator\\AppData\\Local\\Python\\pythoncore-3.14-64\\Scripts\\uv.exe",
        "tool",
        "run",
        "--from",
        "token-savior-recall",
        "token-savior"
